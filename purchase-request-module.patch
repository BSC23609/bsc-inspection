@@ -0,0 +1,416 @@
+{% extends "base.html" %}
+{% block title %}Purchase Request — Metfraa{% endblock %}
+
+{% block content %}
+<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8" x-data="purchaseApp()" x-init="init()" x-cloak>
+
+  <!-- Header -->
+  <div class="mb-6">
+    <div class="lbl mb-2">Metfraa Portal · Procurement</div>
+    <h1 class="display display-xl text-4xl text-metfraa-ink leading-none">Purchase Request</h1>
+    <div class="flex items-center gap-3 mt-3">
+      <span class="h-px w-10 bg-metfraa-blue"></span>
+      <p class="text-sm text-metfraa-gray-500">Raise a request for spares, tools or materials — then track its status.</p>
+    </div>
+  </div>
+
+  <!-- Tabs -->
+  <div class="flex gap-1 mb-6 border-b border-metfraa-gray-200 flex-wrap">
+    <button @click="tab='new'"
+            :class="tab==='new' ? 'border-metfraa-blue text-metfraa-ink' : 'border-transparent text-metfraa-gray-500 hover:text-metfraa-ink'"
+            class="px-4 py-2 text-sm font-bold border-b-2">New Request</button>
+    <button @click="tab='list'; loadRequests()"
+            :class="tab==='list' ? 'border-metfraa-blue text-metfraa-ink' : 'border-transparent text-metfraa-gray-500 hover:text-metfraa-ink'"
+            class="px-4 py-2 text-sm font-bold border-b-2">
+      Requests
+      <span x-show="isAdmin" class="ml-1 text-[10px] font-bold uppercase tracking-wider text-metfraa-gray-400">(all)</span>
+    </button>
+  </div>
+
+  <!-- ============ TAB: NEW REQUEST ============ -->
+  <div x-show="tab==='new'">
+
+    <!-- Section 1: Requester -->
+    <div class="bg-white rounded-xl shadow-sm border border-metfraa-gray-200 p-5 mb-5">
+      <div class="flex items-center gap-2 mb-4">
+        <span class="w-6 h-6 rounded-full bg-metfraa-blue text-white text-xs font-bold flex items-center justify-center">1</span>
+        <h4 class="display font-bold text-metfraa-black">Requester</h4>
+      </div>
+      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
+        <div>
+          <label class="lbl block mb-1">Name <span class="text-red-500">*</span></label>
+          <input type="text" x-model="pr.requester_name"
+                 class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue" />
+        </div>
+        <div>
+          <label class="lbl block mb-1">Department</label>
+          <input type="text" x-model="pr.department" placeholder="e.g. Maintenance, Production"
+                 class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue" />
+        </div>
+        <div>
+          <label class="lbl block mb-1">Request Date <span class="text-red-500">*</span></label>
+          <input type="date" x-model="pr.request_date" :max="todayISO"
+                 class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue" />
+        </div>
+        <div>
+          <label class="lbl block mb-1">WhatsApp Number</label>
+          <input type="tel" x-model="pr.whatsapp" inputmode="numeric" placeholder="10-digit mobile"
+                 class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue" />
+        </div>
+      </div>
+    </div>
+
+    <!-- Section 2: Item details -->
+    <div class="bg-white rounded-xl shadow-sm border border-metfraa-gray-200 p-5 mb-5">
+      <div class="flex items-center gap-2 mb-4">
+        <span class="w-6 h-6 rounded-full bg-metfraa-blue text-white text-xs font-bold flex items-center justify-center">2</span>
+        <h4 class="display font-bold text-metfraa-black">Item Details</h4>
+      </div>
+      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
+        <div class="sm:col-span-2">
+          <label class="lbl block mb-1">Item Name / Description <span class="text-red-500">*</span></label>
+          <textarea x-model="pr.item_name" rows="2" placeholder="What do you need?"
+                    class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue"></textarea>
+        </div>
+        <div>
+          <label class="lbl block mb-1">Category</label>
+          <select x-model="pr.category"
+                  class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue">
+            <option value="spare_parts">Spare parts</option>
+            <option value="tools">Tools</option>
+            <option value="electrical">Electrical</option>
+            <option value="mechanical">Mechanical</option>
+            <option value="raw_material">Raw material</option>
+            <option value="other">Other</option>
+          </select>
+        </div>
+        <div>
+          <label class="lbl block mb-1">Purpose / Machine or Job</label>
+          <input type="text" x-model="pr.purpose" placeholder="e.g. M/C-014 spindle, Line 2"
+                 class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue" />
+        </div>
+        <div class="sm:col-span-2">
+          <label class="lbl block mb-1">Specification / Size / Make / Model / Part Number</label>
+          <textarea x-model="pr.specification" rows="2" placeholder="Technical specs, brand, model, part no."
+                    class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue"></textarea>
+        </div>
+        <div>
+          <label class="lbl block mb-1">Quantity <span class="text-red-500">*</span></label>
+          <input type="number" min="0" step="any" x-model.number="pr.quantity" placeholder="0"
+                 class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue" />
+        </div>
+        <div>
+          <label class="lbl block mb-1">Unit</label>
+          <select x-model="pr.unit"
+                  class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue">
+            <option value="nos">Nos</option>
+            <option value="kg">Kg</option>
+            <option value="meter">Meter</option>
+            <option value="litre">Litre</option>
+            <option value="other">Other</option>
+          </select>
+        </div>
+      </div>
+    </div>
+
+    <!-- Section 3: Priority and cost -->
+    <div class="bg-white rounded-xl shadow-sm border border-metfraa-gray-200 p-5 mb-5">
+      <div class="flex items-center gap-2 mb-4">
+        <span class="w-6 h-6 rounded-full bg-metfraa-blue text-white text-xs font-bold flex items-center justify-center">3</span>
+        <h4 class="display font-bold text-metfraa-black">Priority &amp; Cost</h4>
+      </div>
+      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
+        <div>
+          <label class="lbl block mb-1">Urgency</label>
+          <select x-model="pr.urgency"
+                  class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue">
+            <option value="urgent">Urgent — machine breakdown / production stopped</option>
+            <option value="normal">Normal</option>
+            <option value="low">Low</option>
+          </select>
+        </div>
+        <div>
+          <label class="lbl block mb-1">Required By</label>
+          <input type="date" x-model="pr.required_by" :min="todayISO"
+                 class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue" />
+        </div>
+        <div>
+          <label class="lbl block mb-1">Estimated Cost (₹)</label>
+          <input type="number" min="0" step="any" x-model.number="pr.estimated_cost" placeholder="0"
+                 class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue" />
+        </div>
+        <div>
+          <label class="lbl block mb-1">Preferred Supplier</label>
+          <input type="text" x-model="pr.preferred_supplier" placeholder="Optional"
+                 class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue" />
+        </div>
+        <div>
+          <label class="lbl block mb-2">In Stock?</label>
+          <div class="flex items-center gap-4 mt-1">
+            <label class="flex items-center gap-2 text-sm">
+              <input type="radio" value="yes" x-model="pr.in_stock" class="text-metfraa-blue focus:ring-metfraa-blue" />
+              <span>Yes</span>
+            </label>
+            <label class="flex items-center gap-2 text-sm">
+              <input type="radio" value="no" x-model="pr.in_stock" class="text-metfraa-blue focus:ring-metfraa-blue" />
+              <span>No</span>
+            </label>
+          </div>
+        </div>
+        <div class="sm:col-span-2">
+          <label class="lbl block mb-1">Remarks</label>
+          <textarea x-model="pr.remarks" rows="2" placeholder="Anything else the purchase team should know..."
+                    class="w-full text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue"></textarea>
+        </div>
+      </div>
+    </div>
+
+    <!-- Submit -->
+    <div class="flex justify-end items-center gap-3">
+      <button @click="resetForm()"
+              class="text-sm font-semibold px-4 py-3 rounded-lg border border-metfraa-gray-300 text-metfraa-gray-700 hover:bg-metfraa-gray-50">
+        Clear
+      </button>
+      <button @click="submitRequest()" :disabled="submitting"
+              class="bg-metfraa-blue hover:bg-metfraa-blue-dark text-white font-semibold px-6 py-3 rounded-lg shadow-md hover:shadow-lg disabled:opacity-50 disabled:cursor-not-allowed">
+        <span x-show="!submitting">Submit Request</span>
+        <span x-show="submitting">Submitting...</span>
+      </button>
+    </div>
+  </div>
+
+  <!-- ============ TAB: REQUESTS ============ -->
+  <div x-show="tab==='list'">
+    <div class="bg-white rounded-xl shadow-sm border border-metfraa-gray-200 p-5">
+      <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
+        <div>
+          <div class="lbl">Submitted Requests</div>
+          <h3 class="display font-bold text-metfraa-black" x-text="isAdmin ? 'All requests' : 'My requests'"></h3>
+        </div>
+        <div class="flex items-center gap-2">
+          <select x-model="filterStatus"
+                  class="text-sm rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue">
+            <option value="">All statuses</option>
+            <option value="Pending">Pending</option>
+            <option value="Approved">Approved</option>
+            <option value="Rejected">Rejected</option>
+            <option value="Purchased">Purchased</option>
+          </select>
+          <button @click="loadRequests()" class="text-xs font-semibold px-3 py-2 rounded-lg border border-metfraa-gray-300 hover:bg-metfraa-gray-50">Refresh</button>
+        </div>
+      </div>
+
+      <div x-show="loading" class="text-center py-10 text-metfraa-gray-500 text-sm">Loading…</div>
+
+      <div x-show="!loading && filtered.length === 0" class="text-center py-12 text-metfraa-gray-500 text-sm">
+        No requests to show.
+      </div>
+
+      <div x-show="!loading && filtered.length > 0" class="overflow-x-auto">
+        <table class="w-full text-sm">
+          <thead>
+            <tr class="text-left border-b border-metfraa-gray-200">
+              <th class="pb-2 pr-3 lbl">#</th>
+              <th class="pb-2 pr-3 lbl">Date</th>
+              <th class="pb-2 pr-3 lbl">Item</th>
+              <th class="pb-2 pr-3 lbl">Category</th>
+              <th class="pb-2 pr-3 lbl text-right">Qty</th>
+              <th class="pb-2 pr-3 lbl">Urgency</th>
+              <th x-show="isAdmin" class="pb-2 pr-3 lbl">Requester</th>
+              <th class="pb-2 pr-3 lbl">Status</th>
+              <th x-show="isAdmin" class="pb-2 lbl">Action</th>
+            </tr>
+          </thead>
+          <tbody>
+            <template x-for="r in filtered" :key="r.id">
+              <tr class="border-b border-metfraa-gray-100 align-top hover:bg-metfraa-gray-50">
+                <td class="py-3 pr-3 mono text-metfraa-gray-400" x-text="r.id"></td>
+                <td class="py-3 pr-3 whitespace-nowrap" x-text="fmtDate(r.request_date)"></td>
+                <td class="py-3 pr-3">
+                  <div class="font-semibold text-metfraa-ink" x-text="r.item_name"></div>
+                  <div class="text-[11px] text-metfraa-gray-500" x-show="r.purpose" x-text="r.purpose"></div>
+                  <div class="text-[11px] text-metfraa-gray-500" x-show="r.specification" x-text="r.specification"></div>
+                </td>
+                <td class="py-3 pr-3" x-text="catLabel(r.category)"></td>
+                <td class="py-3 pr-3 text-right mono">
+                  <span x-text="r.quantity ?? ''"></span> <span class="text-metfraa-gray-400" x-text="unitLabel(r.unit)"></span>
+                </td>
+                <td class="py-3 pr-3">
+                  <span class="text-xs font-semibold px-2 py-0.5 rounded"
+                        :class="({urgent:'bg-red-100 text-red-800', normal:'bg-metfraa-gray-100 text-metfraa-gray-700', low:'bg-metfraa-gray-100 text-metfraa-gray-500'})[r.urgency] || 'bg-metfraa-gray-100'"
+                        x-text="urgLabel(r.urgency)"></span>
+                </td>
+                <td x-show="isAdmin" class="py-3 pr-3">
+                  <div class="text-metfraa-ink" x-text="r.created_by_name || r.requester_name"></div>
+                  <div class="text-[11px] text-metfraa-gray-500" x-show="r.department" x-text="r.department"></div>
+                </td>
+                <td class="py-3 pr-3">
+                  <span class="text-xs font-bold px-2 py-1 rounded"
+                        :class="statusClass(r.status)" x-text="r.status"></span>
+                  <div class="text-[11px] text-metfraa-gray-500 mt-1" x-show="r.admin_note" x-text="r.admin_note"></div>
+                </td>
+                <td x-show="isAdmin" class="py-3">
+                  <select @change="setStatus(r, $event.target.value); $event.target.value=''"
+                          class="text-xs rounded-lg border-metfraa-gray-300 focus:border-metfraa-blue focus:ring-metfraa-blue">
+                    <option value="">Set…</option>
+                    <option value="Pending">Pending</option>
+                    <option value="Approved">Approved</option>
+                    <option value="Rejected">Rejected</option>
+                    <option value="Purchased">Purchased</option>
+                  </select>
+                </td>
+              </tr>
+            </template>
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+
+</div>
+
+<script>
+function purchaseApp() {
+  return {
+    tab: 'new',
+    isAdmin: {{ 'true' if is_admin else 'false' }},
+    todayISO: new Date().toISOString().slice(0, 10),
+    submitting: false,
+    loading: false,
+    requests: [],
+    filterStatus: '',
+
+    pr: {},
+
+    get filtered() {
+      if (!this.filterStatus) return this.requests;
+      return this.requests.filter(r => r.status === this.filterStatus);
+    },
+
+    init() {
+      this.resetForm();
+      fetch('/purchase-requests/api/context')
+        .then(r => r.ok ? r.json() : null)
+        .then(d => {
+          if (!d) return;
+          this.isAdmin = !!d.is_admin;
+          if (d.me) {
+            if (!this.pr.requester_name) this.pr.requester_name = d.me.name || '';
+            if (!this.pr.department) this.pr.department = d.me.department || '';
+            if (!this.pr.whatsapp) this.pr.whatsapp = d.me.whatsapp || '';
+          }
+        })
+        .catch(() => {});
+    },
+
+    resetForm() {
+      this.pr = {
+        requester_name: '',
+        department: '',
+        request_date: this.todayISO,
+        whatsapp: '',
+        item_name: '',
+        category: 'spare_parts',
+        specification: '',
+        quantity: null,
+        unit: 'nos',
+        purpose: '',
+        urgency: 'normal',
+        required_by: '',
+        estimated_cost: null,
+        preferred_supplier: '',
+        in_stock: 'no',
+        remarks: '',
+      };
+    },
+
+    async submitRequest() {
+      if (!this.pr.requester_name || !this.pr.requester_name.trim()) { toast('Enter the requester name', 'error'); return; }
+      if (!this.pr.item_name || !this.pr.item_name.trim()) { toast('Enter the item name / description', 'error'); return; }
+      if (!this.pr.quantity || this.pr.quantity <= 0) { toast('Enter a quantity', 'error'); return; }
+      this.submitting = true;
+      try {
+        const res = await fetch('/purchase-requests/api/requests', {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify(this.pr),
+        });
+        const data = await res.json();
+        if (!res.ok) throw new Error(data.detail || 'Submit failed');
+        toast('Purchase request submitted', 'success');
+        this.resetForm();
+        this.tab = 'list';
+        this.loadRequests();
+      } catch (e) {
+        toast(e.message, 'error');
+      } finally {
+        this.submitting = false;
+      }
+    },
+
+    async loadRequests() {
+      this.loading = true;
+      try {
+        const res = await fetch('/purchase-requests/api/requests');
+        const data = await res.json();
+        if (!res.ok) throw new Error(data.detail || 'Load failed');
+        this.requests = data.requests || [];
+        this.isAdmin = !!data.is_admin;
+      } catch (e) {
+        toast(e.message, 'error');
+      } finally {
+        this.loading = false;
+      }
+    },
+
+    async setStatus(row, status) {
+      if (!status || status === row.status) return;
+      let note = '';
+      if (status === 'Rejected') {
+        note = window.prompt('Reason for rejection (optional):', row.admin_note || '') || '';
+      }
+      try {
+        const res = await fetch(`/purchase-requests/api/requests/${row.id}/status`, {
+          method: 'POST',
+          headers: { 'Content-Type': 'application/json' },
+          body: JSON.stringify({ status, note }),
+        });
+        const data = await res.json();
+        if (!res.ok) throw new Error(data.detail || 'Update failed');
+        const i = this.requests.findIndex(x => x.id === row.id);
+        if (i >= 0) this.requests[i] = data.request;
+        toast('Status updated to ' + status, 'success');
+      } catch (e) {
+        toast(e.message, 'error');
+      }
+    },
+
+    statusClass(s) {
+      return ({
+        Pending: 'bg-amber-100 text-amber-800',
+        Approved: 'bg-emerald-100 text-emerald-800',
+        Rejected: 'bg-red-100 text-red-800',
+        Purchased: 'bg-blue-100 text-blue-800',
+      })[s] || 'bg-metfraa-gray-100 text-metfraa-gray-700';
+    },
+    catLabel(c) {
+      return ({
+        spare_parts: 'Spare parts', tools: 'Tools', electrical: 'Electrical',
+        mechanical: 'Mechanical', raw_material: 'Raw material', other: 'Other',
+      })[c] || (c || '—');
+    },
+    unitLabel(u) {
+      return ({ nos: 'Nos', kg: 'Kg', meter: 'Meter', litre: 'Litre', other: '' })[u] || (u || '');
+    },
+    urgLabel(u) {
+      return ({ urgent: 'Urgent', normal: 'Normal', low: 'Low' })[u] || (u || '—');
+    },
+    fmtDate(iso) {
+      if (!iso) return '';
+      const p = iso.split('-');
+      return p.length === 3 ? `${p[2]}-${p[1]}-${p[0]}` : iso;
+    },
+  };
+}
+</script>
+{% endblock %}
