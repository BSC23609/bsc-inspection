+++ b/app/routes/purchase.py
@@ -0,0 +1,201 @@
+"""Purchase Request module — raise and track procurement requests.
+
+Any logged-in employee can raise a request (spares, tools, materials) and see
+the requests they raised. Admins (any portal admin role) see every request and
+move it through the status flow: Pending → Approved / Rejected / Purchased.
+"""
+import logging
+from datetime import date, datetime
+
+from fastapi import APIRouter, Depends, HTTPException, Request
+from fastapi.responses import HTMLResponse
+from fastapi.templating import Jinja2Templates
+from sqlalchemy.orm import Session
+
+from ..access import get_access
+from ..database import get_db
+from ..deps import get_current_user_ready
+from ..models import Employee, PurchaseRequest
+
+router = APIRouter(prefix="/purchase-requests", tags=["purchase"])
+log = logging.getLogger("purchase")
+templates = Jinja2Templates(directory="app/templates")
+
+STATUSES = ("Pending", "Approved", "Rejected", "Purchased")
+
+
+def _is_admin(db: Session, user: Employee) -> bool:
+    """Who may see all requests and change status. Any portal admin role."""
+    return get_access(db, user).any_admin
+
+
+def _parse_date(v):
+    """ISO 'YYYY-MM-DD' (or '') -> date | None."""
+    if not v:
+        return None
+    try:
+        return date.fromisoformat(str(v)[:10])
+    except (ValueError, TypeError):
+        return None
+
+
+def _num(v):
+    if v in (None, ""):
+        return None
+    try:
+        return float(v)
+    except (ValueError, TypeError):
+        return None
+
+
+def _iso(d):
+    return d.isoformat() if d else None
+
+
+def _serialize(pr: PurchaseRequest) -> dict:
+    return {
+        "id": pr.id,
+        "requester_name": pr.requester_name,
+        "department": pr.department,
+        "request_date": _iso(pr.request_date),
+        "whatsapp": pr.whatsapp,
+        "item_name": pr.item_name,
+        "category": pr.category,
+        "specification": pr.specification,
+        "quantity": pr.quantity,
+        "unit": pr.unit,
+        "purpose": pr.purpose,
+        "urgency": pr.urgency,
+        "required_by": _iso(pr.required_by),
+        "estimated_cost": pr.estimated_cost,
+        "preferred_supplier": pr.preferred_supplier,
+        "in_stock": pr.in_stock,
+        "remarks": pr.remarks,
+        "status": pr.status,
+        "admin_note": pr.admin_note,
+        "created_by_id": pr.created_by_id,
+        "created_by_name": pr.created_by.name if pr.created_by else pr.requester_name,
+        "created_at": pr.created_at.isoformat() if pr.created_at else None,
+        "decided_by_name": pr.decided_by.name if pr.decided_by else None,
+        "decided_at": pr.decided_at.isoformat() if pr.decided_at else None,
+    }
+
+
+@router.get("/", response_class=HTMLResponse)
+def purchase_page(
+    request: Request,
+    db: Session = Depends(get_db),
+    user: Employee = Depends(get_current_user_ready),
+):
+    """Module page — New Request form + Requests tab."""
+    return templates.TemplateResponse(
+        request,
+        "purchase.html",
+        {"user": user, "is_admin": _is_admin(db, user)},
+    )
+
+
+@router.get("/api/context")
+def api_context(
+    db: Session = Depends(get_db),
+    user: Employee = Depends(get_current_user_ready),
+):
+    """Identity + whether this user is an admin for the module (prefills the
+    form and decides whether the Requests tab shows everyone's rows)."""
+    return {
+        "me": {
+            "id": user.id,
+            "name": user.name,
+            "department": user.department or user.designation or "",
+            "whatsapp": user.phone or "",
+        },
+        "is_admin": _is_admin(db, user),
+    }
+
+
+@router.get("/api/requests")
+def api_list(
+    db: Session = Depends(get_db),
+    user: Employee = Depends(get_current_user_ready),
+):
+    """Admin -> every request; ordinary user -> only their own."""
+    q = db.query(PurchaseRequest)
+    if not _is_admin(db, user):
+        q = q.filter(PurchaseRequest.created_by_id == user.id)
+    rows = q.order_by(PurchaseRequest.id.desc()).all()
+    return {"requests": [_serialize(r) for r in rows], "is_admin": _is_admin(db, user)}
+
+
+@router.post("/api/requests")
+def api_create(
+    body: dict,
+    db: Session = Depends(get_db),
+    user: Employee = Depends(get_current_user_ready),
+):
+    """Create a request. created_by is always the signed-in user."""
+    name = (body.get("requester_name") or user.name or "").strip()
+    item = (body.get("item_name") or "").strip()
+    if not name:
+        raise HTTPException(status_code=400, detail="Requester name is required")
+    if not item:
+        raise HTTPException(status_code=400, detail="Item name / description is required")
+
+    cat = (body.get("category") or "").strip() or None
+    urg = (body.get("urgency") or "").strip() or "normal"
+    unit = (body.get("unit") or "").strip() or None
+    in_stock = (body.get("in_stock") or "").strip().lower()
+    if in_stock not in ("yes", "no"):
+        in_stock = None
+
+    pr = PurchaseRequest(
+        requester_name=name,
+        department=(body.get("department") or "").strip() or None,
+        request_date=_parse_date(body.get("request_date")) or date.today(),
+        whatsapp=(body.get("whatsapp") or "").strip() or None,
+        item_name=item,
+        category=cat,
+        specification=(body.get("specification") or "").strip() or None,
+        quantity=_num(body.get("quantity")),
+        unit=unit,
+        purpose=(body.get("purpose") or "").strip() or None,
+        urgency=urg,
+        required_by=_parse_date(body.get("required_by")),
+        estimated_cost=_num(body.get("estimated_cost")),
+        preferred_supplier=(body.get("preferred_supplier") or "").strip() or None,
+        in_stock=in_stock,
+        remarks=(body.get("remarks") or "").strip() or None,
+        status="Pending",
+        created_by_id=user.id,
+        created_at=datetime.utcnow(),
+    )
+    db.add(pr)
+    db.commit()
+    db.refresh(pr)
+    return {"ok": True, "request": _serialize(pr)}
+
+
+@router.post("/api/requests/{req_id}/status")
+def api_set_status(
+    req_id: int,
+    body: dict,
+    db: Session = Depends(get_db),
+    user: Employee = Depends(get_current_user_ready),
+):
+    """Admin-only: move a request through the status flow."""
+    if not _is_admin(db, user):
+        raise HTTPException(status_code=403, detail="Admin access only")
+    status = (body.get("status") or "").strip().title()
+    if status not in STATUSES:
+        raise HTTPException(status_code=400, detail="Invalid status")
+    pr = db.query(PurchaseRequest).filter(PurchaseRequest.id == req_id).first()
+    if not pr:
+        raise HTTPException(status_code=404, detail="Request not found")
+    pr.status = status
+    note = (body.get("note") or "").strip()
+    if note:
+        pr.admin_note = note
+    pr.decided_by_id = user.id
+    pr.decided_at = datetime.utcnow()
+    db.commit()
+    db.refresh(pr)
+    return {"ok": True, "request": _serialize(pr)}
