+class PurchaseRequest(Base):
+    """A procurement request raised by any employee (spares, tools, materials).
+
+    One request = one item line (matches the form: a single category, quantity
+    and unit). Admins see every request and move it through the status flow;
+    an ordinary user sees only the requests they raised.
+    """
+    __tablename__ = "purchase_requests"
+
+    id = Column(Integer, primary_key=True)
+
+    # --- Section 1: Requester ---
+    requester_name = Column(String(255), nullable=False)
+    department = Column(String(255), nullable=True)
+    request_date = Column(Date, nullable=True)
+    whatsapp = Column(String(32), nullable=True)
+
+    # --- Section 2: Item details ---
+    item_name = Column(Text, nullable=False)                 # name / description
+    category = Column(String(32), nullable=True)             # spare_parts/tools/electrical/mechanical/raw_material/other
+    specification = Column(Text, nullable=True)              # spec / size / make / model / part no.
+    quantity = Column(Float, nullable=True)
+    unit = Column(String(16), nullable=True)                 # nos/kg/meter/litre/other
+    purpose = Column(String(255), nullable=True)             # purpose / machine or job
+
+    # --- Section 3: Priority & cost ---
+    urgency = Column(String(16), nullable=True)              # urgent/normal/low
+    required_by = Column(Date, nullable=True)
+    estimated_cost = Column(Float, nullable=True)            # INR
+    preferred_supplier = Column(String(255), nullable=True)
+    in_stock = Column(String(8), nullable=True)              # yes/no
+    remarks = Column(Text, nullable=True)
+
+    # --- Status flow ---
+    status = Column(String(16), nullable=False, default="Pending")  # Pending/Approved/Rejected/Purchased
+    admin_note = Column(Text, nullable=True)                 # reason on reject / note on action
+
+    # --- Ownership / audit ---
+    created_by_id = Column(Integer, ForeignKey("employees.id"), nullable=True, index=True)
+    created_at = Column(DateTime, default=datetime.utcnow)
+    decided_by_id = Column(Integer, ForeignKey("employees.id"), nullable=True)
+    decided_at = Column(DateTime, nullable=True)
+
+    created_by = relationship("Employee", foreign_keys=[created_by_id])
+    decided_by = relationship("Employee", foreign_keys=[decided_by_id])
